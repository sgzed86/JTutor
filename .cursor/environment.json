{
  "name": "Jtutor",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "PYTHONIOENCODING=utf-8 python3 -m uvicorn backend.app.main:app --host 127.0.0.1 --port 8765"
    },
    {
      "name": "ui",
      "command": "npm run dev --prefix apps/desktop"
    }
  ],
  "ports": [
    { "name": "api", "port": 8765 },
    { "name": "ui", "port": 5173 }
  ]
}
